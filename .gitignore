# dependencies
node_modules

# build output
dist
dist-ssr
*.local

# TypeScript incremental build cache
*.tsbuildinfo

# editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db

# vite
.vite

# --- engine ---------------------------------------------------------------

# secrets: camera credentials live here and must never be committed
engine/.env

# python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# runtime data: database, extracted clips, captured footage
engine/data/

# --- model weights ---------------------------------------------------------
# 1.2 GB of binaries. Tracked out of band, not in git.
# models/MODELS.md and models/README.md ARE tracked — they are the record of
# what is supposed to be in the folder.
models/*.pt
models/*.pth
models/*.onnx
models/*.engine
models/*.weights
models/*.safetensors

# generated per-model sidecars — regenerate with engine/tools/audit_models.py
models/*_pt.yaml
models/*_pth.yaml
models/*_onnx.yaml
models/*_engine.yaml

# --- speckit / repo hygiene (added 18 Aug 2026) -----------------------------
_to_delete/
.speckit-init.zip

# kaggle API credentials - never commit
models/knife detection/kaggle.json

# 659 MB of training clips - tracked out of band, like the weights
models/knife detection/knife_clips/
models/knife detection/archive/

# training clips of real people - never commit. Consent and retention for
# footage of minors is an open question (docs/PLAN.md D1), and a repo is the
# one place footage can never be withdrawn from.
models/knife detection/*.mp4

# local tooling state (ruflo / claude-flow plugins) - machine-specific
.claude-flow/
.claude/proven-config.json
.claude/.proven-config-version
# Roboflow training scripts. Removed from the repo and purged from history:
# three of them had a live API key typed into the source. The files are still
# on disk because they are yours; this stops `git add -A` putting the key back.
models/knife detection/train_knife_model_colab.py
models/knife detection/train_knife_model_kaggle_colab.py
models/knife detection/train_knife_model_merged.py
models/knife detection/train_knife_model_v2_combined.py
models/knife detection/train_knife_model_v3_custom.py

# --- owner-supplied datasets (added 27 Aug 2026) ---------------------------
# 204 MB of EALPR plate photos, supplied by the owner for evaluation.
# plate_truth.csv is the EXCEPTION: the human-confirmed read truth is
# evidence and must be versioned.
Egyptian Car Plates dataset/
!Egyptian Car Plates dataset/plate_truth.csv

# 2.2 GB of bag-tracker material - tracked out of band, like the weights.
models/bag traker/

# The gate-anpr reference project is tracked for its SOURCE - it is what
# infer/plates.py was ported from and what tools/compare_plates.py runs
# against. Its copies of the two plate weights are not: they are the same
# files as models/plate_detector.pt and models/char_detector.pt.
models/Gate/**/*.pt

# --- stray shell-redirect litter at the repo root (27 Aug 2026) ------------
# Accidents from redirected commands ('> $OUT', '> 118'). The files are
# still on disk because they are yours; this only keeps them out of git.
/$OUT
/$TMP_LOG
/.=.swp
/[0-9]
/[0-9][0-9]
/[0-9][0-9][0-9]
