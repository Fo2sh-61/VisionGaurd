# Copy to engine/.env and fill in. engine/.env is gitignored and must stay that way.
#
# Camera credentials belong here, never in engine.yaml. Reference them from the
# yaml as ${VG_RTSP_1}. The adjacent British School project has RTSP passwords
# committed in plaintext in config/cameras.yaml and poc2/config.py — that is the
# pattern this file exists to avoid.

# Full RTSP URL including credentials, e.g.
#   VG_RTSP_1=rtsp://admin:yourpassword@192.168.1.64:554/Streaming/Channels/102
# Prefer the camera's SUB-stream (usually channel 102 / "stream2" / 640x360).
# Analytics don't need 1080p, and at 208 cameras the main stream will not decode.
VG_RTSP_1=

# Optional second camera.
VG_RTSP_2=

# Overrides engine.yaml if set.
# VG_DATABASE_URL=sqlite:///engine/data/visionguard.db

# --- Alerts (P9) -------------------------------------------------------------
# Alerts go out by email, through Gmail with an App Password. These keys live
# here and nowhere else - never in engine.yaml, and the engine never prints
# them in a response, a log line or an audit entry.
#
# Google sees the text of every email. What leaves is facts only (what, where,
# when, how sure, who decided) and never a student's name, a face or a picture.
#
# Leave either empty and email says so in Settings and System Health; every
# would-be message is logged as skipped. Detection is unaffected.
# the Gmail address messages are sent from; needs 2-step verification on
GMAIL_USER=
# a Google App Password (16 letters), not the account password
GMAIL_APP_PASSWORD=
